# ============================================================================
# RESTORING THIS PROJECT? RETRIEVE YOUR SAVED .env FIRST
# Password manager entry: movie-recommender-mlops — .env backup
# Save the real .env there before deleting your local project; this file has no secrets.
# Restore the saved file as .env in the repository root before starting Docker.
# Check AIRFLOW_DOCKER_PROJECT_DIR and AIRFLOW_DOCKER_GID for the current machine.
# Replace the DagsHub token if it has expired or been revoked.
# Never commit the real .env or paste its credentials into GitHub or chat.
# ============================================================================

# SETTINGS GUIDE: Keep all keys; fill only the required private values.
# Supply privately: DAGSHUB_TOKEN, MLFLOW_TRACKING_USERNAME and the existing API
# account passwords DATA_COLLECTION_PASSWORD / PREDICT_SMOKE_PASSWORD.
# Generated if missing: Airflow keys/passwords, AUTH_SECRET_KEY, Grafana password,
# and project path. Run `uv run python airflow/setup_local.py`; it preserves secrets.
# Check without writing: add --check; add --deployment to require an @alias.
# Machine-specific: verify AIRFLOW_DOCKER_PROJECT_DIR and AIRFLOW_DOCKER_GID.
# API credentials: DATA_COLLECTION_* for ingestion, PREDICT_SMOKE_* for deployment.
# Optional choices: model types/version; PREDICT_MODEL_NAME may remain empty.
# Airflow deployment requires an @alias; the `latest` default is for standalone serving.
# Existing database/Grafana passwords are not changed by editing this file or .env.

# Copy this file to .env in the repository root before running Docker Compose.
# Choose your own password. Never commit .env.
# Grafana uses these values to initialize its admin account on first startup.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# DagsHub storage bucket, used by the data_collection_service.
# Create a token under DagsHub -> User Settings -> Tokens.
DAGSHUB_S3_ENDPOINT_URL=https://dagshub.com/api/v1/repo-buckets/s3/abulhawa
DAGSHUB_BUCKET=movie-recommender-mlops
DAGSHUB_TOKEN=

# Training candidate only; does not switch the prediction service.
# Supported values: knn, two_tower. Build the selected image before running.
MODEL_TYPE=knn

# Serving selection is independent of training. Newest registered version at startup.
PREDICT_MODEL_TYPE=knn
# Leave empty to use the registry model name for PREDICT_MODEL_TYPE.
PREDICT_MODEL_NAME=
# For Airflow deployment, use an owned alias such as @live or @latest-verified.
PREDICT_MODEL_VERSION=latest

# Shared DagsHub-hosted MLflow. Uses DAGSHUB_TOKEN above as its password.
MLFLOW_TRACKING_URI=https://dagshub.com/abulhawa/movie-recommender-mlops.mlflow
MLFLOW_TRACKING_USERNAME=

# Airflow metadata database (docker-compose.yml).
# Use a long random hexadecimal password; it is embedded in a connection URI.
# This account is for PostgreSQL, not the future Airflow dashboard login.
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_PASSWORD=

# Shared Airflow encryption/signing keys. Generate locally with:
# python airflow/setup_local.py
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# Airflow dashboard account, initialized in PostgreSQL by the API container.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=

# Absolute project root as seen by Docker Engine (not /opt/airflow).
# Generated by python airflow/setup_local.py. On Docker Desktop Windows, e.g.:
# /run/desktop/mnt/host/d/Git/Liora/MLOPS/Final Pro-Movie Reco-With Team
AIRFLOW_DOCKER_PROJECT_DIR=
# Socket group ID; setup detects/repairs this when the socket is accessible.
# If detection is unavailable, verify this number on the Docker host.
AIRFLOW_DOCKER_GID=0

# Existing admin account of the data collection API, used by the Airflow
# data_ingestion DAG (see src/user_authentication_service/README.md).
# Without a local users.json the demo account admin / admin123 applies.
DATA_COLLECTION_USERNAME=admin
DATA_COLLECTION_PASSWORD=

# Existing API account used to obtain a fresh JWT for each deployment.
PREDICT_SMOKE_USERNAME=alice
PREDICT_SMOKE_PASSWORD=
# Signs the login tokens. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
